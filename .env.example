# Local Docker Compose configuration for NVIDIA DGX Spark (GB10, Linux/arm64).
# Copy to .env in this repository. NVIDIA Container Toolkit is required.

# vLLM downloads this model into ./hf-cache on first start.
VLLM_MODEL=Qwen/Qwen3.5-35B-A3B-FP8

# Sized for the DGX Spark's shared CPU/GPU memory.
VLLM_GPU_MEM_UTIL=0.38
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=8
VLLM_MAX_NUM_BATCHED_TOKENS=8192

# Host ports. ComfyUI uses host networking and always listens on 8188.
VLLM_PORT=8001
SILLYTAVERN_PORT=8010

KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu:v0.9.0-cu126

# Bind mounts resolve against this repository when running Compose locally.
HF_CACHE_DIR=./hf-cache
COMFYUI_DIR=./comfyui
SILLYTAVERN_DIR=./sillytavern
BRIGHT_COMPOSER_DIR=./bright_composer

COMPOSER_POLL_INTERVAL=5
# Leave empty when no print receiver is running on the local network.
COMPOSER_PUSH_URL=
