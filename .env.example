# Comic-Style Storyteller - stack configuration
# Copy to .env and adjust. .env is gitignored; this file is committed.

# ---------------------------------------------------------------- model
# Swap the served model here - this is the ONLY line to change.
# Present in hf-cache/, so none of these needs a download:
#   Qwen/Qwen3.5-35B-A3B-FP8               (native FP8, ~37.5 GB - current)
#   AEON-7/Qwen3.6-35B-A3B-heretic-NVFP4   (abliterated)
#   nvidia/Qwen3.6-35B-A3B-NVFP4           (stock NVFP4)
#
# Qwen3.5-35B-A3B is also published unquantized at 71.9 GB. Do NOT use that one
# without also raising VLLM_GPU_MEM_UTIL to ~0.66, which reverses the memory
# headroom deliberately left for ComfyUI. The FP8 build fits at 0.38.
#
# NOTE: the "heretic" build is abliterated, which on a thinking model can damage
# the <think> block structure that --reasoning-parser=qwen3 depends on. If you
# see reasoning-parser errors after a swap, that is the first thing to suspect.
VLLM_MODEL=Qwen/Qwen3.5-35B-A3B-FP8

# ---------------------------------------------------------------- memory
# The Spark has 128 GB of UNIFIED memory on a single 273 GB/s bus, shared
# between vLLM and ComfyUI. Raising this starves ComfyUI. See README.
# 0.38 x 121.6 GiB = ~46.2 GiB, of which ~10.8 GiB is KV cache = ~800k tokens.
# Was 0.45 (~54.7 GiB) until 2026-08-31. The KV cache was sized for 1.23M tokens
# against a hard ceiling of max_num_seqs(8) x max_model_len(32768) = 262,144, so
# ~4.7x more than could ever be reached. 0.38 still leaves ~3.1x headroom and
# returns ~9 GiB to ComfyUI, which is the component that was actually tight.
# Old note kept for reference:
# 0.45 x 121.6 GiB = ~54.7 GiB, of which ~26 GiB is KV cache = ~2.6M tokens,
# roughly 10x what max-model-len x max-num-seqs can actually consume.
VLLM_GPU_MEM_UTIL=0.38
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=8
VLLM_MAX_NUM_BATCHED_TOKENS=8192

# ---------------------------------------------------------------- ports
VLLM_PORT=8001
COMFYUI_PORT=8188
SILLYTAVERN_PORT=8010

# ---------------------------------------------------------------- paths
# ABSOLUTE, deliberately. docker-compose.yml already defaults to these exact
# values, so the stack works with no .env at all - which is what a Portainer
# Git-backed stack sees, since .env is not committed.
#
# They must NOT be compose-relative: Portainer clones the repo into its own
# volume and would resolve relative paths against that clone, where hf-cache/
# and comfyui/models/ do not exist (both are gitignored). The stack would come
# up with no weights and no models.
#
# Only change these if you move the repo.
HF_CACHE_DIR=/home/s.urso/Bright-2026-Comic-style-Storyteller/hf-cache
COMFYUI_DIR=/home/s.urso/Bright-2026-Comic-style-Storyteller/comfyui
SILLYTAVERN_DIR=/home/s.urso/Bright-2026-Comic-style-Storyteller/sillytavern

BRIGHT_COMPOSER_DIR=/home/s.urso/Bright-2026-Comic-style-Storyteller/bright_composer
COMPOSER_POLL_INTERVAL=5
